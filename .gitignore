# build artifacts
/build/bin/
/frontend/dist/
/nexus

# `make shots` output: the PNG matrix, its throwaway XDG_DATA_HOME and
# XDG_RUNTIME_DIR, and the per-state process logs. The target regenerates all of
# it and wipes the directory first; S3-29's README grid picks frames out of it by
# hand rather than the repository carrying them.
/build/shots/

# wails build caches the frontend install with a checksum file
/frontend/package.json.md5

# deps
/frontend/node_modules/

# coverage profiles written by `make cover`
coverage*.out

# vitest artefacts. `make front-test` writes none today — it runs plain
# `vitest --run` — but `--coverage` and the HTML reporter both drop a directory
# here the moment somebody passes a flag, and an untracked directory is a dirty
# tree on the next `git status --porcelain`.
/frontend/coverage/
/frontend/html/

# local data
*.db
*.db-shm
*.db-wal

# editor / os
.DS_Store
*.swp
